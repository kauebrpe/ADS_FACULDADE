#include <stdio.h>

typedef struct { // Criando uma "caixa"
	int mat; // Matricula
	char nome[50]; // Nome
	float nota; // Nota
} Tcandidato; // Nome da Estrutura

float calcularMedia(Tcandidato candidato[15]) {
	float soma = 0;
	float mediafinal;
    int p;
    for (p = 0; p < 15; p++) {
		soma = soma + candidato[p].nota;
	}
	mediafinal = soma / 15;
	
	return mediafinal;
}

int maiorNota(Tcandidato candidato[]) {
	int maior;
	int p;
	maior = 0;
	for (p = 1; p < 15; p++) {
		if (candidato[p].nota > candidato[maior].nota) {
			maior = p;
		}

	}
	return maior;
}

int menorNota(Tcandidato candidato[]) {
	int menor;
	int p;
	menor = 0;
	for (p = 1; p < 15; p++) {
		if (candidato[p].nota < candidato[menor].nota) {
			menor = p;
		}

	}
	return menor;
}

void buscarMatricula(Tcandidato candidato[]) {
	int matricula;
	int p;
	int encontrado = 0;
	printf("Digite a matricula: ");
	scanf("%d", &matricula);
	for (p = 0; p < 15; p++) {
		if (candidato[p].mat == matricula) {
			printf("Nome: %s\n", candidato[p].nome);
			printf("Nota: %.2f\n", candidato[p].nota);
			
			encontrado = 1;
			
			break;
		}
	}
	if (encontrado == 0) {

        printf("Candidato nao encontrado\n");

    }
}


int main(){
	int opcao;
	int p;
	Tcandidato candidato[15]; // Cada candidato com seus dados
	do {
		printf("\nMENU\n");
		printf("1 - Cadastrar candidatos\n");
		printf("2 - Media geral\n");
		printf("3 - Maior e menor nota\n");
		printf("4 - Buscar matricula\n");
		printf("0 - Sair\n");
		
		printf("Escolha: ");
		scanf("%i", &opcao);
		
		if (opcao == 1){
			for (p = 0; p < 15; p++){
				printf("\nCandidato %d\n", p + 1); // Mostrar qual candidato foi cadastrado
				
				printf("Matricula: ");
				scanf("%d", &candidato[p].mat);
				
				printf("Nome: ");
				scanf("%s", candidato[p].nome);
				
				printf("Nota: ");
				scanf("%f", &candidato[p].nota);
			}
		}
		
		if (opcao == 2){
			float resultado;
			resultado = calcularMedia(candidato);
			printf("Media geral: %.2f\n", resultado);
				
		}
		if (opcao == 3) {

    		int maior;
    		int menor;

    		maior = maiorNota(candidato);
    		menor = menorNota(candidato);

    		printf("Maior nota: %s - %.2f\n", candidato[maior].nome, candidato[maior].nota);
			printf("Menor nota: %s - %.2f\n", candidato[menor].nome, candidato[menor].nota);
		}
		if (opcao == 4) {

    		buscarMatricula(candidato);

		}
	} while(opcao !=0); // Repita até o usuário digitar 0
	
	
	
	return 0;
}
