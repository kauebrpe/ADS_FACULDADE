#include <stdio.h>
int main () {
  int p;
  int v1[20];
  int maior;
  int menor;

  printf("Me diga um numero: ");
  scanf("%i", &v1[0]);
  maior = v1[0];
  menor = v1[0];
  
  for (p=1; p<20; p++){
    printf("Me diga um numero %d: ", p);
    scanf("%i", &v1[p]);
    
    if (v1[p] >= maior){
      maior = v1[p];
    }
    if (v1[p] <= menor){
      menor = v1[p];
    }
  }
  printf("O maior numero e %i e o menor e %i", maior, menor);
 
  return 0;
}
